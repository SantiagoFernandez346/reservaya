# Copiá este archivo como .env.local. Todo es opcional en desarrollo:
# sin variables, la app usa PGlite (Postgres local), pagos simulados y el asistente básico.

# Postgres en la nube (Neon, Supabase…). Sin esto se usa PGlite en la carpeta .pglite
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# Cadena larga y secreta para firmar las sesiones (obligatoria en producción)
# Generá una con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESION_SECRETO=

# Mercado Pago (credenciales de prueba: empiezan con TEST-). Sin esto, el checkout es simulado
# MP_ACCESS_TOKEN=TEST-...
# Clave secreta del webhook (Tus integraciones → Webhooks → Clave secreta)
# MP_WEBHOOK_SECRET=

# Asistente con Claude. Sin esto, el asistente usa el intérprete por reglas
# ANTHROPIC_API_KEY=

# URL pública del sitio (para los links de vuelta de Mercado Pago). Opcional en local
# APP_URL=https://reservaya.vercel.app
